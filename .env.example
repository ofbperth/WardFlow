# Optional fallback when request headers are unavailable.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase public client
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Supabase server-side access
SUPABASE_SERVICE_ROLE_KEY=

# Required for live clinical data. Server-only; never use NEXT_PUBLIC_ here.
# JSON mapping of key IDs to independently generated 32-byte base64 keys.
# Keep backed-up keys outside the database/repository; see docs/clinical-encryption.md.
WARDFLOW_ENCRYPTION_KEY_ID=
WARDFLOW_ENCRYPTION_KEYS=
# Enable only during the controlled legacy-data migration; default is false.
WARDFLOW_ENCRYPTION_ALLOW_LEGACY_READS=false

# Optional Google Docs export via service account
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=
GOOGLE_DRIVE_FOLDER_ID=

# Optional project metadata
WARDFLOW_GITHUB_REPO_URL=https://github.com/ofbperth/WardFlow.git
